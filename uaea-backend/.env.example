# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://uaea:uaea@localhost:5432/uaea
DATABASE_URL_SYNC=postgresql+psycopg2://uaea:uaea@localhost:5432/uaea
POSTGRES_USER=uaea
POSTGRES_PASSWORD=uaea
POSTGRES_DB=uaea

# ── LLM (Groq — free fast inference) ─────────────────────────────────────
LLM_API_KEY=gsk-REPLACE-ME
LLM_BASE_URL=https://api.groq.com/openai/v1
# llama-3.3-70b-versatile was shut down by Groq on 16 Aug 2026 — use gpt-oss-120b.
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# ── Embeddings (OpenAI text-embedding-3-small) ───────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-REPLACE-ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_IP=60/minute
RATE_LIMIT_PER_SESSION=30/minute

# ── Admin RBAC (simple API-key for MVP) ──────────────────────────────────────
ADMIN_API_KEY=uaea-admin-dev-key-change-in-production

# ── OTP verification over WhatsApp ───────────────────────────────────────────
# Every demo student record uses this number; private lookups send the code here.
DEMO_STUDENT_PHONE=+923333797617
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ACCESS_MINUTES=15
OTP_SECRET=change-me-to-a-long-random-string
# true = also show the code inside the chat (local demos only, never in production)
OTP_DEV_ECHO=false

# console = print the code in the backend log (no WhatsApp message is sent)
# twilio  = Twilio WhatsApp (sandbox works for demos)
# meta    = WhatsApp Cloud API (production; needs an approved authentication template)
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en_US

# Pretend "today" is this date (YYYY-MM-DD). Leave blank for the real date.
TODAY_OVERRIDE=
TIMEZONE=Asia/Karachi

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
