# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://uaea:uaea@localhost:5432/uaea
DATABASE_URL_SYNC=postgresql+psycopg2://uaea:uaea@localhost:5432/uaea
POSTGRES_USER=uaea
POSTGRES_PASSWORD=uaea
POSTGRES_DB=uaea

# ── LLM (Groq — free fast inference) ─────────────────────────────────────
LLM_API_KEY=gsk-REPLACE-ME
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ── Embeddings (OpenAI text-embedding-3-small) ───────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-REPLACE-ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_IP=60/minute
RATE_LIMIT_PER_SESSION=30/minute

# ── Admin RBAC (simple API-key for MVP) ──────────────────────────────────────
ADMIN_API_KEY=uaea-admin-dev-key-change-in-production

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
